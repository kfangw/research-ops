# 비밀값
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# 환경
__pycache__/
.venv/
node_modules/
.DS_Store
tmp/
_to_delete*/

# 원자료와 큰 결과. 요약만 커밋한다
data/raw/*
!data/raw/.gitkeep
results/raw/*
!results/raw/.gitkeep
*.tar.gz
*.zip
*.parquet
*.sqlite

# 투고용 artifact 작업본
artifact-export/

# 사용자 컴퓨터에만 두는 것: git bundle, 압축 중복본, 자동 저장 기록
_local/
*.bundle
.fuse_hidden*
*.scaffold
