#!/usr/bin/env bash
# commit-msg: 커밋 작성자 규칙을 지킨다. 규칙은 docs/설정.md의 "커밋 작성자" 절에 있다.
#
#   1. 작성자는 사용자다. 작성자 이름이 도구 이름이거나 메일이 도구의 주소면 막는다.
#      설정에 사용자 메일이 적혀 있으면 작성자 메일이 그 주소와 같아야 한다.
#   2. 도구 접두([도구])로 시작하는 커밋에는 그 도구의 Co-Authored-By 줄이 있어야 한다.
#
# 스캐폴드가 `git config core.hooksPath code/hooks`로 건다. 새로 클론한 곳에서는 이 명령을 한 번 실행한다.
# 사용자가 일부러 건너뛸 때만 `git commit --no-verify`를 쓴다. 도구는 건너뛰지 않는다.
set -u
MSG="$1"
TOOLS="{{도구1}} {{도구2}}"
# 도구 이름으로 흔히 들어오는 작성자. 위 도구 목록과 함께 막는다
KNOWN="claude chatgpt codex gemini copilot cursor"
KNOWN_MAIL="noreply@anthropic.com noreply@openai.com"

ROOT="$(git rev-parse --show-toplevel)"
CONF="$ROOT/docs/설정.md"
lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
section() { [ -f "$CONF" ] && sed -n '/^## 커밋 작성자/,/^## /p' "$CONF"; }

ident="$(git var GIT_AUTHOR_IDENT)"
a_name="${ident% <*}"; rest="${ident#*<}"; a_mail="${rest%%>*}"
want="$(section | sed -n 's/^- 메일: *//p' | head -1 | tr -d ' ')"
case "$want" in *@*) ;; *) want="";; esac

stop() {
  printf 'commit-msg: %s\n' "$1" >&2
  printf '  지금 작성자: %s <%s>\n' "$a_name" "$a_mail" >&2
  printf '  고치는 법: git config user.name "<사용자 이름>"; git config user.email "%s"\n' "${want:-<사용자 메일>}" >&2
  printf '  도구는 작성자가 되지 않고 메시지 끝의 Co-Authored-By 줄로 적는다(docs/설정.md).\n' >&2
  exit 1
}

n="$(lc "$a_name")"; m="$(lc "$a_mail")"
for t in $TOOLS $KNOWN; do [ "$n" = "$t" ] && stop "작성자 이름이 도구 이름($t)이다."; done
for k in $KNOWN_MAIL; do [ "$m" = "$k" ] && stop "작성자 메일이 도구의 주소($k)다."; done
[ -n "$want" ] && [ "$m" != "$(lc "$want")" ] && stop "작성자 메일이 docs/설정.md의 사용자 메일($want)과 다르다."

first="$(grep -v '^#' "$MSG" | sed -n '1p')"
for t in $TOOLS; do
  case "$first" in
    "[$t]"*)
      if ! grep -iqE "^Co-Authored-By: *$t([^a-z0-9-]|\$)" "$MSG"; then
        printf 'commit-msg: [%s] 커밋에 공동 작성자 줄이 없다. 메시지 끝에 빈 줄 하나를 두고 다음 줄을 붙인다.\n' "$t" >&2
        line="$(section | grep -i "co-authored-by: *$t" | sed 's/^[^`]*`//; s/`.*$//' | head -1)"
        printf '  %s\n' "${line:-Co-Authored-By: $t <주소>}" >&2
        exit 1
      fi;;
  esac
done
exit 0
